# Devnet config for aml-workspace.
# Merged on top of .env whenever AML_NETWORK=devnet.
#
# Copy this file to `.env.devnet` and fill in your devnet deployer wallet.

AML_NETWORK=devnet
AML_RPC=https://devnet.octrascan.io/rpc
AML_EXPLORER=https://devnet.octrascan.io

# Devnet-only key. NEVER reuse this key on mainnet.
AML_DEPLOYER_ADDR=
AML_DEPLOYER_PRIV=
