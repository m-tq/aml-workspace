# aml-workspace — env template.
#
# Copy this file to `.env`, then optionally add `.env.devnet` / `.env.mainnet`
# to override individual fields per-network.
#
# Precedence (first match wins per key):
#
#   1. shell env          AML_NETWORK=mainnet npm run deploy
#   2. .env.<network>     e.g. .env.mainnet
#   3. .env               this file
#
# Legacy ONS_* / OCTRA_* keys are honored as fallbacks so deployers used to
# the ONS layout can drop env files in place.

# ─── Core ────────────────────────────────────────────────────────────────

# devnet | mainnet — drives default RPC + explorer + deployment.<network>.json
AML_NETWORK=devnet

# Active contract source. Override to deploy a different file.
#   examples:
#     AML_CONTRACT=contract/main.aml
#     AML_CONTRACT=contract/templates/token/main.aml
AML_CONTRACT=contract/main.aml

# Optional override for the build-artifact namespace (build/<name>/).
# Defaults to the file basename, or the parent dir when basename is the
# generic "main" / "index" / "contract" — so each template gets its own
# build/<template>/ directory automatically.
# AML_CONTRACT_NAME=my_token

# Constructor params as a JSON array (positional, in source order).
# Examples:
#   token:   AML_CONSTRUCTOR_ARGS=["MyToken","MTK",1000000000,6]
#   escrow:  AML_CONSTRUCTOR_ARGS=["oct...seller","oct...buyer","oct...arbiter"]
#   empty:   AML_CONSTRUCTOR_ARGS=[]
AML_CONSTRUCTOR_ARGS=[]

# Deployer credentials. Required for deploy / save-abi / verify / test.
AML_DEPLOYER_ADDR=
AML_DEPLOYER_PRIV=

# ─── Network endpoints (optional — defaults per-network are built in) ────

# AML_RPC=http://165.227.225.79:8080
# AML_EXPLORER=https://devnet.octrascan.io

# ─── Fee budgets for the scripts (raw OU) ────────────────────────────────

AML_DEPLOY_FEE_OU=200000
AML_CALL_FEE_OU=1000
