# Mainnet config for aml-workspace.
# Merged on top of .env whenever AML_NETWORK=mainnet.
#
# Copy this file to `.env.mainnet`.
# DO NOT commit a populated `.env.mainnet` to git.

AML_NETWORK=mainnet
AML_RPC=https://octrascan.io/rpc
AML_EXPLORER=https://octrascan.io

# Mainnet deployer credentials. Treat as a production secret.
AML_DEPLOYER_ADDR=
AML_DEPLOYER_PRIV=

# Deployment also requires AML_CONFIRM_MAINNET=1 in the shell environment.
